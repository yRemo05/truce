QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
ANTHROPIC_API_KEY=

# Optional limits for a public demo (defaults shown)
# DAILY_TRUCE_CAP=250       model-run truces per UTC day, then rule-based agents
# TRUCE_DAILY_TOTAL=500     truces started per UTC day; past it, demos replay a recorded run
# TRUCE_CONCURRENCY=6       truces planning at once
# QLOO_RESERVE=1500         Qloo calls kept back each month; below it, no new truces start
# DATA_DIR=data             where the SQLite file lives (a volume in production)
