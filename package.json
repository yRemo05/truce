{
  "name": "truce",
  "version": "0.1.0",
  "private": true,
  "description": "Taste agents negotiate one shared evening for a couple or a group of friends, grounded in Qloo's taste graph, with a fairness ledger.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file=.env src/server/index.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/server/index.ts",
    "test": "npm run test:qloo && npm run test:bargain && npm run test:ledger && npm run test:negotiate && npm run test:plan && npm run test:swap && npm run test:ops",
    "test:qloo": "tsx scripts/test-qloo-parse.ts",
    "test:bargain": "tsx scripts/test-bargain.ts",
    "test:ledger": "tsx scripts/test-ledger.ts",
    "test:negotiate": "tsx scripts/test-negotiate.ts",
    "test:plan": "tsx scripts/test-plan.ts",
    "probe": "node --env-file=.env scripts/probe.mjs",
    "live": "node --env-file=.env --import tsx scripts/live-truce.ts",
    "test:swap": "tsx scripts/test-swap.ts",
    "test:ops": "tsx scripts/test-ops.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@hono/node-server": "^2.1.5",
    "@photostructure/tz-lookup": "11.7.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
